#!/bin/sh
# Reject package-lock.json if it was generated on Windows.
# When npm runs on Linux/WSL it installs @emnapi/core and @emnapi/runtime as optional
# peer deps; Windows npm omits these entries entirely. Their absence is the reliable signal.
if git diff --cached --name-only | grep -q "^package-lock.json$"; then
    if ! git show :package-lock.json | grep -q '"node_modules/@emnapi/core"'; then
        echo "Error: package-lock.json was generated on Windows (@emnapi/core is missing)."
        echo "Please regenerate it in WSL: wsl npm install"
        exit 1
    fi
fi
