#!/bin/sh
# Reject package-lock.json if it contains Windows CRLF line endings.
if git diff --cached --name-only | grep -q "^package-lock.json$"; then
    if git show :package-lock.json | grep -q $'\r'; then
        echo "Error: package-lock.json contains Windows line endings (CRLF)."
        echo "Regenerate it with: npm install"
        exit 1
    fi
fi
